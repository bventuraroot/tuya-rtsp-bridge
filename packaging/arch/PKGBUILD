# Maintainer: DanEng1982 <DanEng1982@users.noreply.github.com>
# Arch / Garuda / Manjaro package for https://github.com/DanEng1982/tuya-rtsp-bridge
#
# In-tree (recommended while developing packaging):
#   cd packaging/arch && makepkg -si
#
# From a published tag only (AUR / clean release rebuild):
#   RELEASE=1 makepkg -si

pkgname=tuya-rtsp-bridge
pkgver=1.2.3
pkgrel=1
pkgdesc='Local RTSP for Tuya / Smart Life cameras (QR login → Frigate, Agent DVR, go2rtc)'
arch=('x86_64' 'aarch64')
url='https://github.com/DanEng1982/tuya-rtsp-bridge'
license=('MIT')
depends=(
  'python'
  'python-requests'
  'python-pillow'
  'python-qrcode'
  'python-colorama'
  'python-cryptography'
  'python-pyaes'
  'tk'
)
optdepends=(
  'vlc: in-app live preview (libVLC)'
  'ffmpeg: RTSP watchdog byte probe'
)
makedepends=(
  'go'
  'python-pip'
  'python-wheel'
  'python-setuptools'
)

# startdir = directory containing this PKGBUILD (packaging/arch)
_repo="$(realpath "${startdir}/../..")"
_release_tarball_sum='8e37832546a6730d812b1a1d83bf52929270bccd870c1d54fc57acbe85b3779b'

if [[ "${RELEASE:-0}" == "1" ]]; then
  source=("$pkgname-$pkgver.tar.gz::https://github.com/DanEng1982/tuya-rtsp-bridge/archive/refs/tags/v$pkgver.tar.gz")
  sha256sums=("$_release_tarball_sum")
else
  # Snapshot of the live checkout (includes uncommitted packaging edits).
  # Generated next to the PKGBUILD on first makepkg parse via a small helper below.
  source=("$pkgname-$pkgver.tar.gz")
  sha256sums=('SKIP')
fi

options=('!strip' '!debug')

# Build local source tarball before makepkg integrity checks when not RELEASE=1.
if [[ "${RELEASE:-0}" != "1" ]]; then
  _tar="$startdir/$pkgname-$pkgver.tar.gz"
  if [[ -f "$_repo/src/server.py" ]]; then
    # Refresh snapshot every build so packaging edits are picked up.
    tar -C "$_repo" \
      --exclude='.git' \
      --exclude='.venv' \
      --exclude='venv' \
      --exclude='bin' \
      --exclude='**/__pycache__' \
      --exclude='*.pyc' \
      --exclude='packaging/arch/*.pkg.tar*' \
      --exclude='packaging/arch/pkg' \
      --exclude='packaging/arch/src' \
      --exclude='packaging/arch/*.tar.gz' \
      --exclude='packaging/windows/cache' \
      --exclude='packaging/windows/staging' \
      --transform "s,^,${pkgname}-${pkgver}/," \
      -czf "$_tar" .
  fi
fi

prepare() {
  cd "$srcdir/$pkgname-$pkgver"

  mkdir -p "$srcdir/wheels"
  # Prefer binary wheels; fall back to sdist if needed.
  # Always system interpreter — never a venv python from the caller PATH.
  local py=/usr/bin/python
  "$py" -m pip download \
    --dest "$srcdir/wheels" \
    --only-binary=:all: \
    tinytuya 'python-vlc>=3.0.20123' 2>/dev/null \
  || "$py" -m pip download \
    --dest "$srcdir/wheels" \
    tinytuya 'python-vlc>=3.0.20123'
}

build() {
  cd "$srcdir/$pkgname-$pkgver/vendor/tuya-ipc-terminal"
  export CGO_ENABLED=0
  export GOFLAGS='-trimpath -mod=readonly'
  go build -ldflags='-s -w' -o "$srcdir/tuya-ipc-terminal" .
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local root="$pkgdir/usr/lib/$pkgname"

  install -d "$root"/{src,web,bin,site-packages}

  cp -a src/. "$root/src/"
  cp -a web/. "$root/web/"

  # Engine binary is enough at runtime; keep LICENSE for NOTICE compliance.
  install -d "$root/vendor/tuya-ipc-terminal"
  install -Dm644 vendor/tuya-ipc-terminal/LICENSE \
    "$root/vendor/tuya-ipc-terminal/LICENSE"
  if [[ -f vendor/tuya-ipc-terminal/UPSTREAM.md ]]; then
    install -Dm644 vendor/tuya-ipc-terminal/UPSTREAM.md \
      "$root/vendor/tuya-ipc-terminal/UPSTREAM.md"
  fi

  install -Dm755 "$srcdir/tuya-ipc-terminal" "$root/bin/tuya-ipc-terminal"

  /usr/bin/python -m pip install \
    --no-index \
    --find-links="$srcdir/wheels" \
    --target="$root/site-packages" \
    --no-compile \
    --no-warn-script-location \
    --no-deps \
    tinytuya python-vlc

  rm -rf "$root/site-packages/bin" 2>/dev/null || true

  install -Dm755 packaging/linux/tuya-rtsp-bridge \
    "$pkgdir/usr/bin/tuya-rtsp-bridge"
  install -Dm644 packaging/linux/tuya-rtsp-bridge.desktop \
    "$pkgdir/usr/share/applications/tuya-rtsp-bridge.desktop"
  install -Dm644 packaging/linux/tuya-rtsp-bridge.service \
    "$pkgdir/usr/lib/systemd/user/tuya-rtsp-bridge.service"

  if [[ -f docs/images/logo-mark.png ]]; then
    install -Dm644 docs/images/logo-mark.png \
      "$pkgdir/usr/share/icons/hicolor/256x256/apps/tuya-rtsp-bridge.png"
  fi
  if [[ -f docs/images/logo.svg ]]; then
    install -Dm644 docs/images/logo.svg \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/tuya-rtsp-bridge.svg"
  fi

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
  install -Dm644 DEPENDENCIES.md "$pkgdir/usr/share/doc/$pkgname/DEPENDENCIES.md"
  if [[ -f docs/arch-linux.md ]]; then
    install -Dm644 docs/arch-linux.md "$pkgdir/usr/share/doc/$pkgname/arch-linux.md"
  fi
}
