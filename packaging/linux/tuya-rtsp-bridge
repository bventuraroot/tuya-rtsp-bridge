#!/usr/bin/env bash
# System launcher for the Arch/Garuda package (and any /usr/lib install).
set -euo pipefail

ROOT="${TUYA_BRIDGE_ROOT:-/usr/lib/tuya-rtsp-bridge}"
export TUYA_BRIDGE_ROOT="$ROOT"

# App sources + private site-packages (tinytuya, python-vlc).
# System site-packages (requests, pillow, …) stay on the default path.
PY_PATH="$ROOT/src"
if [[ -d "$ROOT/site-packages" ]]; then
  PY_PATH="$PY_PATH:$ROOT/site-packages"
fi
export PYTHONPATH="${PY_PATH}${PYTHONPATH:+:$PYTHONPATH}"

# Prefer package venv if an older install left one; else *system* python3.
# Never inherit a random venv python from PATH (Hermes, conda, …).
if [[ -x "$ROOT/venv/bin/python" ]]; then
  PY="$ROOT/venv/bin/python"
elif [[ -n "${PYTHON:-}" && -x "${PYTHON}" ]]; then
  PY="$PYTHON"
elif [[ -x /usr/bin/python3 ]]; then
  PY=/usr/bin/python3
else
  PY=python3
fi

case "${1:-}" in
  --server|--headless)
    exec "$PY" -u "$ROOT/src/server.py"
    ;;
  --version|-V)
    if [[ -f /usr/share/doc/tuya-rtsp-bridge/arch-linux.md ]]; then
      pacman -Q tuya-rtsp-bridge 2>/dev/null || true
    fi
    exec "$PY" -c "print('tuya-rtsp-bridge', end=' '); import pathlib; print(pathlib.Path('$ROOT').name)"
    ;;
  -h|--help)
    cat <<'EOF'
tuya-rtsp-bridge — Tuya / Smart Life → local RTSP

  tuya-rtsp-bridge           Desktop GUI (Tk) + backend
  tuya-rtsp-bridge --server  Headless API :8787 + RTSP :8554
  tuya-rtsp-bridge --headless
                             Same as --server

Data:   ~/.local/share/tuya-rtsp-bridge/
Config: ~/.config/tuya-rtsp-bridge/config.json

User service:
  systemctl --user enable --now tuya-rtsp-bridge.service
EOF
    exit 0
    ;;
esac

exec "$PY" -u "$ROOT/src/gui.py"
